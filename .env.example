# 可通过环境变量直接配置；.env 可选，环境变量优先。
# 应用只读取配置并做 Rust 类型转换，不额外校验非空、取值范围或服务兼容性；请按以下注释填写。
# 必填：OpenAI 或 OpenAI-compatible 服务的凭据与模型名
OPENAI_API_KEY=your-api-key
OPENAI_MODEL=gpt-4.1-mini

# 可选：兼容服务地址，默认 https://api.openai.com/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# 可选：temperature 默认 0.7，约定填写 0 到 2 之间的数字
# 可选：max_tokens 默认 1024，约定填写正整数
AGENT_TEMPERATURE=0.7
AGENT_MAX_TOKENS=1024

# 可选：默认不设置；设置时填写 true 或 false，仅用于支持 chat_template_kwargs.enable_thinking 的兼容服务
# AGENT_ENABLE_THINKING=false

# 可选：默认关闭；填写 true 或 false；公布内置 Skill 摘要，并注册只读的 load_skill 工具按需加载完整指令
AGENT_ENABLE_SKILLS=false
# 可选：默认关闭；填写 true 或 false；注册 shell 工具后模型可在本机执行 shell 命令（有真实副作用）
AGENT_ENABLE_TOOLS=false
